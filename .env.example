# Copy to .env and replace every "change-me". .env is git-ignored. All data is synthetic.
# Use URL-safe passwords (letters, digits, - _ .): the ERP password is placed inside a database URL.

# Bootstrap superuser: used only by the postgres init script and manual administration.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ERP login: can connect only to erp_db. erp-backend uses it.
ERP_DB_USER=erp_app
ERP_DB_PASSWORD=change-me

# Brain worker login: owns the Brain's tables in brain_db (brain-worker; feature 003).
BRAIN_DB_USER=brain_app
BRAIN_DB_PASSWORD=change-me
# Brain API login: may only read eight result tables in brain_db (brain-api; feature 003 R-16).
BRAIN_API_DB_USER=brain_api
BRAIN_API_DB_PASSWORD=change-me

# The one pharmacy-manager account that `python -m erp.seed` creates.
ERP_MANAGER_USERNAME=manager
ERP_MANAGER_PASSWORD=change-me

# Host ports (change them if something else on this machine already uses 8080 or 8000).
FRONTEND_PORT=8080
ERP_BACKEND_PORT=8000

# Bearer-token lifetime in minutes.
ERP_JWT_TTL_MINUTES=480

# Simulate Sales: spike size is mean + z x std dev of the last 28 closed days.
ERP_SPIKE_Z=4
# Simulate Sales: share of a product's daily baseline added per run.
ERP_SIMULATE_BATCH_FRACTION=0.25
# Simulate Sales: share of units sold that come back as returns.
ERP_SIMULATE_RETURN_RATE=0.02
# Optional: fix the Simulate Sales random seed (leave empty for a fresh one each run).
ERP_RANDOM_SEED=

# Seed generator: fixed seed so every reseed produces the same synthetic data.
ERP_SEED_RANDOM_SEED=20261202

# Canonical API: lifetime of a newly issued Brain service token, in days.
ERP_SERVICE_TOKEN_TTL_DAYS=90
# Longest a request's database transaction may run, 1-100 seconds (keeps polling's 120 s overlap safe).
ERP_DB_TRANSACTION_TIMEOUT_SECONDS=60

# Brain settings (feature 003 research R-19). Uncomment to change a default.
# BRAIN_POLL_INTERVAL_MINUTES=5
# BRAIN_POLL_OVERLAP_SECONDS=120
# BRAIN_POLL_HISTORY_DAYS=120
# BRAIN_HOURLY_MINUTE=7
# BRAIN_END_OF_DAY_TIME=02:00
# BRAIN_ANOMALY_Z=4
# BRAIN_ANOMALY_MIN_HISTORY_DAYS=28
# BRAIN_REVIEW_PERIOD_DAYS=0
# BRAIN_SAFETY_Z=1.65
# BRAIN_DEFAULT_PACK_MULTIPLE=1
# BRAIN_FORECAST_HORIZON_DAYS=14
# BRAIN_BACKTEST_DAYS=28
# BRAIN_LGBM_MIN_HISTORY_DAYS=56
# BRAIN_LGBM_MARGIN=0.05
# BRAIN_RANGE_LOW_QUANTILE=0.10
# BRAIN_RANGE_HIGH_QUANTILE=0.90
# BRAIN_DEGRADATION_FACTOR=1.5
# BRAIN_LIVE_WAPE_MIN_DAYS=7
# BRAIN_LIVE_WAPE_MAX_DAYS=28
# BRAIN_SAFETY_SD_WINDOW_DAYS=28
# BRAIN_FORECASTS_HISTORY_DAYS=28

# Feature 005, the assistant. The Gemini API key is NOT set here: put it, with no newline, in
# secrets/gemini_api_key (gitignored). An empty file means offline mode.
# The model ID (default gemini-3.5-flash-lite: fastest in the live checks; research R-05).
# BRAIN_GEMINI_MODEL=gemini-3.5-flash-lite
# The demo's offline switch: point the Brain at a closed port, then recreate brain-api/worker.
# BRAIN_GEMINI_BASE_URL=http://127.0.0.1:9
# How much the model thinks before answering: minimal, low (default), medium, high; empty = none sent.
# BRAIN_GEMINI_THINKING_LEVEL=low
